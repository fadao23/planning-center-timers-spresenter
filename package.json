{
  "name": "planning-center-timers-spresenter",
  "version": "0.1.0",
  "description": "Drive Planning Center Services LIVE from Spresenter and keep Spresenter's timer in step with the current plan item.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Fernando Borja",
  "repository": {
    "type": "git",
    "url": "https://github.com/fadao23/planning-center-timers-spresenter.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:code": "vite build --config vite.code.config.ts",
    "build:ui": "vite build --config vite.ui.config.ts",
    "build": "npm run build:code && npm run build:ui",
    "dev": "concurrently -k \"npm:watch:code\" \"npm:watch:ui\"",
    "watch:code": "vite build --watch --config vite.code.config.ts",
    "watch:ui": "vite build --watch --config vite.ui.config.ts",
    "package": "npm run build && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:version": "node scripts/check-version.mjs",
    "ci": "npm run verify:version && npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run package"
  },
  "dependencies": {
    "@spresenter/plugin-sdk": "file:sdk/spresenter-plugin-sdk.tgz",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "adm-zip": "^0.6.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
